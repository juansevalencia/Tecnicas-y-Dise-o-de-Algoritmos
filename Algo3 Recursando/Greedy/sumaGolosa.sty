int sumaGolosa(vector<int> S){
    S.sort(); //heapsort, ascendente
    acum = S[0];
    res = 0;
    for (int i = 1 ; i < n ; i++){
        acum+= acum + S[i]; //me baso en que el minimo resultado va a ser lo minimo que voy a ir acumulando. Lo minimo que voy puedo acumular es ir agarrando los minimos
        res+= acum;
    }
    return res;   
}

